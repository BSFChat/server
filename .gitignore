# Build directories (CMake out-of-tree). `build-*/` covers the throwaway
# trees people actually use — build-fix/, build-sec/, build-asan/ — which
# were showing up as hundreds of megabytes of untracked noise in git status.
build/
build-*/

# Local runtime state: sqlite databases, uploaded media, and dev keys.
# Never commit — data/keys/ holds real private keys.
data/

# CMake incremental / tooling artefacts
.cache/
CMakeFiles/
CMakeCache.txt
compile_commands.json
CMakeUserPresets.json

# Local config with real secrets. Only config/*.example.toml is tracked.
*.local.toml

# e2e run artefacts: tests/e2e/*.sh regenerate this directory (config, db,
# media, logs) on every run. server.toml in here was tracked by accident and
# carried one machine's absolute paths.
tests/e2e/e2e-run/
# Scratch trees the e2e scripts build: one per script, each holding a
# throwaway server.toml, sqlite db and captured responses.
tests/e2e/e2e-run-*/

# Logs and editor noise
*.log
*.swp
*~
.DS_Store
.vscode/
.idea/

# Python bytecode from scripts/ (the release-channel tooling).
__pycache__/
*.pyc
